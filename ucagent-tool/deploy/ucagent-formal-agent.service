# Shared-Agent candidate; retains the previous stage-only service and all its evidence.
[Unit]
Description=UCAgent shared formal Agent workbench
After=network.target

[Service]
Type=simple
User=ucagent
Group=ucagent
WorkingDirectory=/home/ucagent-lab/development/20260912-formal-agent
Environment=HOME=/home/ucagent-lab/home
Environment=PYTHONPATH=/home/ucagent-lab/development/20260912-formal-agent
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONNOUSERSITE=1
ExecStart=/home/ucagent-lab/releases/20260908-formalmc-restore1/venv/bin/python -m ucagent.server.platform_main --workspace /home/ucagent-lab/development/20260912-formal-agent/live-state --import-root /home/ucagent-lab/workspaces --import-root /home/ucagent-lab/development/20260912-formal-agent/acceptance/formal_gui_fixture --toolchains /home/ucagent-lab/development/20260912-formal-agent/deploy/toolchains.formal-agent.example.yaml --host 127.0.0.1 --port 8812
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
KillMode=control-group
UMask=0027
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
