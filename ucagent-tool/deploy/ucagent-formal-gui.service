# Isolated formal workbench: deliberately leaves the existing port 8800 service unchanged.
[Unit]
Description=UCAgent formal stage workbench (isolated)
After=network.target

[Service]
Type=simple
User=ucagent
Group=ucagent
WorkingDirectory=/home/ucagent-lab/development/20260911-formal-gui
Environment=HOME=/home/ucagent-lab/home
Environment=PYTHONPATH=/home/ucagent-lab/development/20260911-formal-gui
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONNOUSERSITE=1
ExecStart=/home/ucagent-lab/releases/20260908-formalmc-restore1/venv/bin/python -m ucagent.server.platform_main --workspace /home/ucagent-lab/development/20260911-formal-gui/live-state --import-root /home/ucagent-lab/workspaces --import-root /home/ucagent-lab/development/20260911-formal-gui/acceptance/formal_gui_fixture --host 127.0.0.1 --port 8811
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
KillMode=control-group
UMask=0027
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
